showRewardsReport = function()
    local old = gui:FindFirstChild("RewardReport")
    if old then old:Destroy();return end
    local rows = {"BECZKA REWARDS / 5", "PlaceId=" .. tostring(game.PlaceId)}
    local backendOK, backendReason = checkRewardBackend()
    table.insert(rows, "Test dostępu: " .. tostring(backendOK) .. " | " .. backendReason .. " | tryb=" .. tostring(rewardBackend))
    local frames = child(PG, "UI", "Base", "Frames")
    if frames then
        for _, window in ipairs(frames:GetChildren()) do
            local name = string.lower(window.Name)
            if name:find("playtime",1,true) or name == "freeegg" or name == "partyegg" then
                table.insert(rows,"WINDOW: " .. window.Name .. " visible=" .. tostring(window.Visible))
                local n = 0
                for _, o in ipairs(window:GetDescendants()) do
                    local isText = textObject(o)
                    local t = isText and cleanText(o.Text) or ""
                    if o:IsA("GuiButton") or isText and (timerSeconds(o.Text) ~= nil
                        or t == "claim" or t == "ready" or t == "playtimeegg") then
                        n = n+1
                        if n <= 65 then
                            local row = o:GetFullName():gsub("Players%.[^.]+%.", "Players.<player>.")
                            if isText then row = row .. " | " .. string.format("%q",o.Text) end
                            if o:IsA("GuiButton") then
                                for i, event in ipairs({"Click","Activated"}) do
                                    local fn = rewardHandler(o,i)
                                    row = row .. " | " .. event .. "=" .. tostring(type(fn)=="function")
                                end
                            end
                            table.insert(rows,row)
                        end
                    end
                end
            end
        end
    else table.insert(rows,"Brak UI.Base.Frames") end
    table.insert(rows, "=== OSTATNIE PRÓBY ===")
    for _, line in ipairs(rewardTrace) do table.insert(rows, line) end
    table.insert(rows, "=== OBSŁUGA KONKRETNYCH PRZYCISKÓW — TYLKO ODCZYT ===")
    local targets = {
        child(frames, "PlaytimeGifts", "Main", "Gifts", "Gift1"),
        child(frames, "PlaytimeEgg", "Main", "Claim")
    }
    local debugAPI = env.debug or debug
    for _, button in pairs(targets) do
        table.insert(rows, "BUTTON: " .. button.Name)
        for _, event in ipairs({"MouseButton1Click", "Activated", "MouseButton1Down", "MouseButton1Up", "InputBegan", "InputEnded"}) do
            local ok, list = pcall(function() return getConnections(button[event]) end)
            if ok and type(list) == "table" then
                table.insert(rows, event .. ": " .. tostring(#list) .. " połączeń")
                for index, connection in ipairs(list) do
                    if index > 3 then break end
                    local readable, fn = pcall(function() return connection.Function end)
                    if readable and type(fn) == "function" and debugAPI then
                        if type(debugAPI.getinfo) == "function" then
                            local infoOK, info = pcall(debugAPI.getinfo, fn)
                            if infoOK and type(info) == "table" then
                                table.insert(rows, "  źródło=" .. tostring(info.short_src or info.source)
                                    .. " linia=" .. tostring(info.linedefined) .. " nazwa=" .. tostring(info.name))
                            end
                        end
                        if type(debugAPI.getconstants) == "function" then
                            local constantsOK, constants = pcall(debugAPI.getconstants, fn)
                            if constantsOK and type(constants) == "table" then
                                local values = {}
                                for _, value in pairs(constants) do
                                    if type(value) == "string" and #value <= 100 and #values < 16 then
                                        table.insert(values, string.format("%q", value))
                                    end
                                end
                                table.insert(rows, "  stałe=" .. table.concat(values, ", "))
                            end
                        end
                    end
                end
            else table.insert(rows, event .. ": brak dostępu") end
        end
    end
    local modal = make("Frame", {Name="RewardReport", AnchorPoint=Vector2.new(0.5,0.5),
        Position=UDim2.fromScale(0.5,0.5), Size=UDim2.fromScale(0.85,0.75),
        BackgroundColor3=C.bg, BorderSizePixel=0, ZIndex=100},gui)
    round(modal,14)
    textAt(modal,"Raport nagród: kliknij tekst → Ctrl+A → Ctrl+C. F7 zamyka.",16,8,620,42,13,C.white,true)
    local box = make("TextBox", {Position=UDim2.fromOffset(16,56),Size=UDim2.new(1,-32,1,-72),
        BackgroundColor3=C.field,TextColor3=C.white,Font=Enum.Font.Code,TextSize=12,
        ClearTextOnFocus=false,MultiLine=true,TextWrapped=false,
        TextXAlignment=Enum.TextXAlignment.Left,TextYAlignment=Enum.TextYAlignment.Top,
        Text=table.concat(rows,"\n")},modal)
    local closeReport = make("TextButton", {Position=UDim2.new(1,-48,0,10),Size=UDim2.fromOffset(32,32),
        Text="×",TextSize=20,TextColor3=C.white,BackgroundColor3=C.field},modal)
    connect(closeReport.Activated,function() modal:Destroy() end)
end




local lastWarning = -math.huge

-- AutoGift nie korzysta z kliknięć, nie otwiera ani nie zamyka okien gry.
while S.alive do
    local now = os.clock()
    if S.held then release() end
    if S.unlocked and S.gift and now >= nextGiftCheck then
        nextGiftCheck = now + 0.75
        local success, err = pcall(stepGifts, now)
        if not success then stopGift(tostring(err)) end
    end
    if S.unlocked and S.fish and not S.starting and not dragging
        and not UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
        and not UIS:GetFocusedTextBox() then
        local success, err = pcall(function()
            local fishingGui = PG:FindFirstChild("FishingGui")
            local fishing = fishingGui and fishingGui:FindFirstChild("Fishing")
            local target = fishing and fishing:FindFirstChild("ClickSpeedUpActive", true)
            if visible(target) then
                if click(target) and not S.gift then setStatus("AutoFish działa.") end
            elseif not S.gift then
                setStatus("Czekam na cel łowienia...")
            end
        end)
        if not success and S.alive then
            release()
            if os.clock() - lastWarning >= 10 then
                lastWarning = os.clock()
                setStatus("AutoFish: błąd kliknięcia — zamknij F9/menu.")
                warn("[BECZKA HUB background-v1]", err)
            end
        end
    end
    task.wait(S.fish and 0.06 or 0.15)
end

release()

if env.__AutoFishPanel == S then
    env.__AutoFishPanel = nil
end
