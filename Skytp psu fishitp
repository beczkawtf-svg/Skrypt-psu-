local windowVersion = 0
local windowOpen = true
local function toggleWindow()
    if not S.alive or S.starting then return end
    windowVersion = windowVersion + 1
    local version = windowVersion
    windowOpen = not windowOpen
    if windowOpen then
        restore.Visible = false
        panel.Visible = true
        panelScale.Scale = fitScale * 0.97
        animate(panel, 0.3, {GroupTransparency = 0})
        animate(panelScale, 0.38, {Scale = fitScale})
        setAmbient(true)
    else
        setAmbient(false)
        animate(panel, 0.2, {GroupTransparency = 1})
        animate(panelScale, 0.24, {Scale = fitScale * 0.97})
        task.delay(0.24, function()
            if not S.alive or version ~= windowVersion then return end
            panel.Visible = false
            restore.Position = panel.Position
            restore.Visible = true
            restore.GroupTransparency = 1
            animate(restore, 0.25, {GroupTransparency = 0})
        end)
    end
end

