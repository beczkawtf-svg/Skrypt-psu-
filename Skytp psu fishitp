-- Test możliwości na prywatnym zdarzeniu, bez wywoływania funkcji gry.
local function checkCallbackBackend()
    if type(getConnections) ~= "function" then
        return false, "Brak getconnections — odbiór w tle niedostępny."
    end
    local probe = Instance.new("BindableEvent")
    local result, reason = false, "Nie udało się sprawdzić dostępu do funkcji."
    local ok, err = pcall(function()
        local empty = getConnections(probe.Event)
        if type(empty) ~= "table" or next(empty) ~= nil then
            reason = "getconnections zwraca fałszywe połączenia pustego zdarzenia."
            return
        end
        local token, received = {}, nil
        local connection = probe.Event:Connect(function(value) received = value end)
        local list = getConnections(probe.Event)
        if type(list) == "table" then
            for _, item in pairs(list) do
                local readable, callback = pcall(function() return item.Function end)
                if readable and type(callback) == "function" then
                    pcall(callback, token)
                    if received == token then result = true;break end
                end
            end
        end
        connection:Disconnect()
        reason = result and "Dostęp do funkcji potwierdzony."
            or "getconnections nie udostępnia prawdziwej funkcji kontrolnego zdarzenia."
    end)
    probe:Destroy()
    if not ok then return false, "Test getconnections zakończył się błędem: " .. tostring(err) end
    return result, reason
end

local signalEmitter = env.firesignal or firesignal
local rewardBackend
local function checkSignalBackend()
    if type(signalEmitter) ~= "function" then return false, "Brak firesignal." end
    local probe = Instance.new("BindableEvent")
    local token, received = {}, nil
    local connection = probe.Event:Connect(function(value) received = value end)
    local ok, err = pcall(signalEmitter, probe.Event, token)
    if ok then
        for _ = 1, 4 do
            if received == token then break end
            task.wait(0.05)
        end
    end
    connection:Disconnect()
    probe:Destroy()
    if not ok then return false, "firesignal: " .. tostring(err) end
    if received ~= token then return false, "firesignal nie wywołał zdarzenia testowego." end
    return true, "firesignal przeszedł test zdarzenia."
end
local function checkRewardBackend()
    -- Ominięcie atrapy getconnections przez osobny mechanizm zdarzeń.
    local signalOK, signalReason = checkSignalBackend()
    if signalOK then
        rewardBackend = "signal"
        return true, signalReason
    end
    local callbackOK, callbackReason = checkCallbackBackend()
    if callbackOK then
        rewardBackend = "callback"
        return true, callbackReason
    end
    rewardBackend = nil
    return false, "Brak działającego odbioru w tle. " .. signalReason
end

local connections = {}
local activeTweens = {}

local function animate(object, duration, properties)
    if not S.alive or not object.Parent then return end
    local tween = TweenService:Create(object,
        TweenInfo.new(duration, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), properties)
    activeTweens[tween] = true
    tween.Completed:Once(function() activeTweens[tween] = nil end)
    tween:Play()
    return tween
end

local function connect(signal, callback)
    local connection = signal:Connect(callback)
    table.insert(connections, connection)
    return connection
end

local function make(className, properties, parent)
    local object = Instance.new(className)

    for property, value in pairs(properties) do
        object[property] = value
    end

    object.Parent = parent
    return object
end

local function round(object, radius)
