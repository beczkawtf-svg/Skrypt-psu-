local function release()
    if not S.held then return true end

    local success, err = pcall(function()
        VI:SendMouseButton(
            S.held,
            Enum.UserInputType.MouseButton1,
            false,
            0
        )
    end)

    if success or string.find(
        tostring(err), "duplicate button state", 1, true
    ) then
        S.held = nil
        return true
    end

    return false, err
end

local function allowed()
    if not VI then
        setStatus("Executor nie udostępnia wymaganej funkcji kliknięć.")
        return false
    end

    return true
end

