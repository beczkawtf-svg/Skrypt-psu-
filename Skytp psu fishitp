-- Pomocnicze funkcje interfejsu gry.
local function visible(object)
    if not object or not object:IsA("GuiObject") then return false end
    if object:IsDescendantOf(gui) then return false end

    local current = object

    while current and current ~= PG do
        if current:IsA("GuiObject") and not current.Visible then
            return false
        elseif current:IsA("ScreenGui") and not current.Enabled then
            return false
        end

        current = current.Parent
    end

    return object:IsDescendantOf(PG)
end

local function inside(object, position)
    if not object.Visible then return false end

    local p = object.AbsolutePosition
    local size = object.AbsoluteSize

    return position.X >= p.X and position.X <= p.X + size.X
        and position.Y >= p.Y and position.Y <= p.Y + size.Y
end

local nextClickAllowed = 0

local function click(object)
    if not S.alive or S.starting or dragging or UIS:GetFocusedTextBox() then
        return false
    end

    if os.clock() < nextClickAllowed then return false end
    if UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
        return false
    end
    if not visible(object) then return false end

    local size = object.AbsoluteSize
    if size.X <= 0 or size.Y <= 0 then return false end

    local position = object.AbsolutePosition + size / 2
    local ancestor = object.Parent

    while ancestor and ancestor ~= PG do
        if ancestor:IsA("GuiObject") and ancestor.ClipsDescendants then
            local p = ancestor.AbsolutePosition
            local s = ancestor.AbsoluteSize

            if position.X < p.X or position.X > p.X + s.X
                or position.Y < p.Y or position.Y > p.Y + s.Y then
                return false
            end
        end

        ancestor = ancestor.Parent
    end

    local screen = object:FindFirstAncestorWhichIsA("ScreenGui")
    if screen and not screen.IgnoreGuiInset then
        position = position + GS:GetGuiInset()
    end

    local camera = workspace.CurrentCamera
    if not camera then return false end

    local viewport = camera.ViewportSize
    if position.X < 0 or position.Y < 0
        or position.X >= viewport.X or position.Y >= viewport.Y then
        return false
    end

    if inside(panel, position) or inside(restore, position) then
        setStatus("Panel zasłania cel. Przesuń go lub użyj F6.")
        return false
    end

    local released, err = release()
    if not released then error(tostring(err), 0) end

    if not S.alive or not visible(object)
        or UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
        return false
    end
    local pressed, pressError = pcall(function()
        VI:SendMouseButton(
            position, Enum.UserInputType.MouseButton1, true, 0
        )
    end)
    if not pressed then
        nextClickAllowed = os.clock() + 0.35
        if string.find(tostring(pressError), "duplicate button state", 1, true) then
            setStatus("Kliknięcie zajęte — czekam na zwolnienie myszy.")
            return false
        end
        error(tostring(pressError), 0)
    end
    S.held = position
    task.wait(0.02)

    local releasedNow, releaseError = release()
    if not releasedNow then error(tostring(releaseError), 0) end

    return true
end

local function normalized(text)
    return string.lower(text):gsub("<[^>]*>", ""):gsub("[%s_%-!]", "")
end

-- BEGIN INCOGNITO
local INCOGNITO_NAME = "BECZKASHOOP"
local privacyConnections = {}
local privacyRecords = setmetatable({}, {__mode = "k"})
local privacyGeneration = 0
local privacyTask
local aliases = {Players.LocalPlayer.Name, Players.LocalPlayer.DisplayName}
table.sort(aliases, function(a, b) return #a > #b end)

local function replaceName(text)
    for _, alias in ipairs(aliases) do
        if alias ~= "" and alias ~= INCOGNITO_NAME then
            local lower, needle = string.lower(text), string.lower(alias)
            local parts, from = {}, 1
            while true do
                local first, last = string.find(lower, needle, from, true)
                if not first then table.insert(parts, text:sub(from)); break end
                local before, after = text:sub(first - 1, first - 1), text:sub(last + 1, last + 1)
                local whole = (first == 1 or not before:match("[%w_]"))
                    and (last == #text or not after:match("[%w_]"))
                table.insert(parts, text:sub(from, first - 1))
                table.insert(parts, whole and INCOGNITO_NAME or text:sub(first, last))
                from = last + 1
            end
            text = table.concat(parts)
        end
    end
    return text
end

local function maskText(text, rich)
    if not rich then return replaceName(text) end
    local pieces, from = {}, 1
    while true do
        local first, last = text:find("<[^>]*>", from)
        if not first then table.insert(pieces, replaceName(text:sub(from))); break end
        table.insert(pieces, replaceName(text:sub(from, first - 1)))
        table.insert(pieces, text:sub(first, last))
        from = last + 1
    end
    return table.concat(pieces)
end

local function privacyConnect(signal, callback)
    local connection = signal:Connect(callback)
    table.insert(privacyConnections, connection)
end

local function watchPrivateText(object)
    if not S.incognito or privacyRecords[object] or object:IsDescendantOf(gui) then return end
    local property
    if object:IsA("TextLabel") or object:IsA("TextButton") then
        property = "Text"
    elseif object:IsA("Humanoid") and Players.LocalPlayer.Character
        and object:IsDescendantOf(Players.LocalPlayer.Character) then
        property = "DisplayName"
    else
        return
    end
    local record = {property = property, original = object[property]}
    privacyRecords[object] = record
    local function update()
        if not S.alive or not S.incognito or not object.Parent then return end
        local current = object[property]
        if current == record.masked then return end
        record.original = current
        local masked = property == "DisplayName" and INCOGNITO_NAME
            or maskText(current, object.RichText)
        record.masked = masked
        if current ~= masked then object[property] = masked end
    end
    privacyConnect(object:GetPropertyChangedSignal(property), function()
        pcall(update)
    end)
    update()
end

setIncognito = function(enabled)
    privacyGeneration = privacyGeneration + 1
    local generation = privacyGeneration
    if privacyTask then pcall(task.cancel, privacyTask); privacyTask = nil end
    S.incognito = enabled
    for _, connection in ipairs(privacyConnections) do connection:Disconnect() end
    table.clear(privacyConnections)
    for object, record in pairs(privacyRecords) do
        pcall(function()
            if object[record.property] == record.masked then
                object[record.property] = record.original
            end
        end)
    end
    privacyRecords = setmetatable({}, {__mode = "k"})
    if not enabled then return end
    local roots = {PG, workspace}
    local coreOK, core = pcall(function()
        local value = game:GetService("CoreGui")
        value:GetChildren() -- Sprawdź uprawnienia przed skanowaniem.
        return value
    end)
    if coreOK and core then table.insert(roots, core) end
    for _, root in ipairs(roots) do
        pcall(function()
            privacyConnect(root.DescendantAdded, function(object)
                pcall(watchPrivateText, object)
            end)
        end)
    end
    privacyConnect(Players.LocalPlayer.CharacterAdded, function(character)
        for _, object in ipairs(character:GetDescendants()) do
            pcall(watchPrivateText, object)
        end
    end)
    -- Jednorazowy skan w porcjach; później tylko zdarzenia zmian tekstu.
    privacyTask = task.spawn(function()
        local count = 0
        for _, root in ipairs(roots) do
            local ok, objects = pcall(function() return root:GetDescendants() end)
            if ok then
                for _, object in ipairs(objects) do
                    if not S.alive or not S.incognito or generation ~= privacyGeneration then return end
                    pcall(watchPrivateText, object)
                    count = count + 1
                    if count % 150 == 0 then task.wait() end
                end
            end
        end
        if S.alive and S.incognito and generation == privacyGeneration then
            setStatus(coreOK and "Incognito: BECZKASHOOP — podmiana lokalna aktywna."
                or "Incognito aktywne. Systemowa topka Roblox może pozostać bez zmian (brak dostępu).")
        end
    end)
end
-- END INCOGNITO

-- BEGIN BACKGROUND GIFTS
local function child(root, ...)
    for _, name in ipairs({...}) do root = root and root:FindFirstChild(name) end
    return root
end
local function textObject(object)
    return object:IsA("TextLabel") or object:IsA("TextButton")
end
local function cleanText(text)
    return normalized(text):gsub("[^%w:]", "")
end
local function timerSeconds(text)
    text = text:gsub("<[^>]*>", ""):match("^%s*(.-)%s*$")
    local h, m, s = text:match("^(%d+):(%d%d):(%d%d)$")
    if h then return tonumber(h)*3600 + tonumber(m)*60 + tonumber(s) end
    m, s = text:match("^(%d+):(%d%d)$")
    if m then return tonumber(m)*60 + tonumber(s) end
end
local function rewardHandler(button, attempt)
    local event = attempt == 1 and "MouseButton1Click" or "Activated"
    if rewardBackend == "signal" then
        return function(...) return signalEmitter(button[event], ...) end, event
    end
    if rewardBackend ~= "callback" then return nil, "Brak sprawdzonego mechanizmu odbioru." end
    local ok, list = pcall(getConnections, button[event])
    if not ok or type(list) ~= "table" then return nil, "Brak dostępu do " .. event end
    local callback
    for _, connection in ipairs(list) do
        local readable, fn, enabled = pcall(function() return connection.Function, connection.Enabled end)
        if readable and enabled ~= false and type(fn) == "function" then
            if callback and callback ~= fn then return nil, "Niejednoznaczna obsługa " .. event end
            callback = fn
        end
    end
    return callback, event
end
local rewardAttempts = setmetatable({}, {__mode = "k"})
local function eggWindow(frames, now)
    return child(frames, "PlaytimeEgg")
end
local function eggState(window)
    local claim = child(window, "Main", "Claim")
    local timer = child(window, "Main", "PlayTime", "TextLabel")
    if not claim or not claim:IsA("GuiButton") or not timer or not textObject(timer) then return nil end
    local seconds = timerSeconds(timer.Text)
    local ready = seconds == 0 or cleanText(timer.Text) == "ready"
    -- Zignoruj CantClaim i RobuxBuy; zamknięte okno nie blokuje odczytu timera.
    return claim, ready and claim.Visible, seconds
end
local rewardTrace = {}
local function traceReward(message)
    table.insert(rewardTrace, message)
    if #rewardTrace > 18 then table.remove(rewardTrace, 1) end
end
local function stopGift(reason)
    S.gift = false
    if S.giftJob and S.giftJob.thread then pcall(task.cancel, S.giftJob.thread) end
    S.giftJob = nil
    refreshSelection()
    setStatus("AutoGift: " .. reason)
    warn("[BECZKA HUB rewards-v2] " .. reason)
end
local function queueReward(button, kind, verify, now)
    local attempts = rewardAttempts[button] or 0
    if attempts >= 2 then return false end
    local attempt = attempts + 1
    rewardAttempts[button] = attempt
    local callback, event = rewardHandler(button, attempt)
    if not callback then traceReward(kind .. ": " .. tostring(event)); return false end
    traceReward(kind .. ": próba " .. tostring(attempt) .. " / " .. tostring(event))
    local job = {started = now, verify = verify, button = button, kind = kind}
    S.giftJob = job
    setStatus("Próba odbioru: " .. kind .. "…")
    job.thread = task.spawn(function()
        local ok, err
        if event == "Activated" then ok, err = pcall(callback, nil, 1)
        else ok, err = pcall(callback) end
        job.error = not ok and tostring(err) or nil
        job.finished = os.clock()
        job.done = true
    end)
    return true
end
local function stepGifts(now)
    if not S.gift or S.starting then return end
    local job = S.giftJob
    if job then
        if job.done then
            local verified, confirmed = pcall(job.verify)
            if verified and confirmed then
                S.giftJob = nil
                traceReward(job.kind .. ": potwierdzona zmiana stanu")
                setStatus("Gra zaktualizowała stan nagrody: " .. job.kind .. ".")
            elseif job.error or now - job.finished >= 3 then
                traceReward(job.kind .. ": " .. (job.error or "callback zakończony, stan nagrody bez zmian"))
                S.giftJob = nil
                if job.error then warn("[BECZKA HUB rewards-v2]", job.kind, job.error) end
            end
        elseif now - job.started >= 8 then
            if job.thread then pcall(task.cancel, job.thread) end
            S.giftJob = nil
            rewardAttempts[job.button] = 2
            traceReward(job.kind .. ": przekroczono 8 sekund")
            setStatus("AutoGift: funkcja " .. job.kind .. " nie odpowiedziała.")
        end
        return
    end
    local frames = child(PG, "UI", "Base", "Frames")
    local window = eggWindow(frames, now)
    local egg, eggReady, remaining = eggState(window)
    if egg and remaining and remaining > 0 then rewardAttempts[egg] = nil end
    if egg and eggReady then
        if queueReward(egg, "jajko 45 min", function()
            local _, _, seconds = eggState(window)
            return seconds ~= nil and seconds > 0
        end, now) then return end
    end
    local gifts = child(frames, "PlaytimeGifts", "Main", "Gifts")
    local blocked = false
    if gifts then
        local list = gifts:GetChildren()
        table.sort(list, function(a,b) return a.Name < b.Name end)
        for _, button in ipairs(list) do
            if button:IsA("GuiButton") and button.Name:match("^Gift%d+$") then
                local label = button:FindFirstChild("TimeDisplay")
                if label and textObject(label) then
                    if cleanText(label.Text) == "ready" then
                        if queueReward(button, button.Name, function()
                            return label.Parent ~= nil and cleanText(label.Text) ~= "ready"
                        end, now) then return end
                        blocked = true
                    else
                        rewardAttempts[button] = nil
                    end
                end
            end
        end
    end
    if blocked or egg and eggReady and (rewardAttempts[egg] or 0) >= 2 then
        setStatus("AutoGift: brak potwierdzenia odbioru. F7: raport nagród.")
    elseif not gifts then
        setStatus("AutoGift: czekam na PlaytimeGifts.Main.Gifts.")
    elseif not window or not egg then
        setStatus("Prezenty aktywne. Brak rozpoznanego przycisku jajka — F7: raport.")
    elseif remaining and remaining > 0 then
        setStatus(string.format("Prezenty aktywne · jajko za %d:%02d", math.floor(remaining/60), remaining%60))
    elseif remaining == nil and not eggReady then
        setStatus("Prezenty aktywne. Czekam na timer / Ready jajka.")
    else
        setStatus("AutoGift: czekam na dostępne nagrody.")
    end
end
