local function interact(object, border)
    local scale = make("UIScale", {Scale = 1}, object)
    connect(object.MouseEnter, function()
        animate(scale, 0.22, {Scale = 1.018})
        if border then animate(border, 0.22, {Transparency = 0.2}) end
    end)
    connect(object.MouseLeave, function()
        animate(scale, 0.28, {Scale = 1})
        if border then animate(border, 0.28, {Transparency = 0.65}) end
    end)
    connect(object.InputBegan, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            animate(scale, 0.1, {Scale = 0.975})
        end
    end)
    connect(object.InputEnded, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            animate(scale, 0.3, {Scale = 1})
        end
    end)
end
