local handle = make("Frame", {
    Size = UDim2.new(1, -90, 0, 68),
    BackgroundTransparency = 1,
    Active = true,
    ZIndex = 10
}, panel)

local dragging = false
local dragInput
local dragStart
local startPosition
local moved = false
local smallDrag = false

local function beginDrag(input, small)
    if dragging then return end

    if input.UserInputType ~= Enum.UserInputType.MouseButton1
        and input.UserInputType ~= Enum.UserInputType.Touch then
        return
    end

    dragging = true
    dragInput = input
    dragStart = input.Position
    startPosition = panel.Position
    moved = false
    smallDrag = small
end

connect(handle.InputBegan, function(input)
    beginDrag(input, false)
end)

connect(restore.InputBegan, function(input)
    beginDrag(input, true)
end)

connect(UIS.InputChanged, function(input)
    if not dragging or not S.alive then return end

    if dragInput.UserInputType == Enum.UserInputType.MouseButton1 then
        if input.UserInputType ~= Enum.UserInputType.MouseMovement then
            return
        end
    elseif input ~= dragInput then
        return
    end

    local delta = input.Position - dragStart
    if delta.Magnitude > 5 then moved = true end
    if not moved then return end

    local camera = workspace.CurrentCamera
    if not camera then return end

    local viewport = camera.ViewportSize
    local size = smallDrag and restore.AbsoluteSize or panel.AbsoluteSize

    local x = math.clamp(
        startPosition.X.Offset + delta.X,
        0,
        math.max(0, viewport.X - size.X)
    )

    local y = math.clamp(
        startPosition.Y.Offset + delta.Y,
        0,
        math.max(0, viewport.Y - size.Y)
    )

    panel.Position = UDim2.fromOffset(x, y)
    restore.Position = panel.Position
end)

connect(UIS.InputEnded, function(input)
    if not dragging or input ~= dragInput then return end

    local reopen = smallDrag and not moved
    dragging = false
    dragInput = nil

    if reopen then toggleWindow() end
end)

S.stop = function()
    if not S.alive then return end

    S.alive = false
    S.fish = false
    S.gift = false
    release()

    for _, connection in ipairs(connections) do
        connection:Disconnect()
    end

    gui:Destroy()
end

connect(close.Activated, function()
    S.stop()
end)

connect(UIS.InputBegan, function(input)
    if input.KeyCode == Enum.KeyCode.F8 then
        S.stop()
    elseif input.KeyCode == Enum.KeyCode.F6
        and not UIS:GetFocusedTextBox() then
        toggleWindow()
    end
end)

-- Pomocnicze funkcje interfejsu gry.
local function visible(object)
    if not object or not object:IsA("GuiObject") then return false end
    if object:IsDescendantOf(gui) then return false end

    local current = object

    while current and current ~= PG do
        if current:IsA("GuiObject") and not current.Visible then
            return false
        elseif current:IsA("ScreenGui") and not current.Enabled then
            return false
        end

        current = current.Parent
    end

    return object:IsDescendantOf(PG)
end

local function inside(object, position)
    if not object.Visible then return false end

    local p = object.AbsolutePosition
    local size = object.AbsoluteSize

    return position.X >= p.X and position.X <= p.X + size.X
        and position.Y >= p.Y and position.Y <= p.Y + size.Y
end

local function click(object)
    if not S.alive or dragging or UIS:GetFocusedTextBox() then
        return false
    end

    if not visible(object) then return false end

    local size = object.AbsoluteSize
    if size.X <= 0 or size.Y <= 0 then return false end

    local position = object.AbsolutePosition + size / 2
    local ancestor = object.Parent

    while ancestor and ancestor ~= PG do
        if ancestor:IsA("GuiObject") and ancestor.ClipsDescendants then
            local p = ancestor.AbsolutePosition
            local s = ancestor.AbsoluteSize

            if position.X < p.X or position.X > p.X + s.X
                or position.Y < p.Y or position.Y > p.Y + s.Y then
                return false
            end
        end

        ancestor = ancestor.Parent
    end

    local screen = object:FindFirstAncestorWhichIsA("ScreenGui")
    if screen and not screen.IgnoreGuiInset then
        position = position + GS:GetGuiInset()
    end

    local camera = workspace.CurrentCamera
    if not camera then return false end

    local viewport = camera.ViewportSize
    if position.X < 0 or position.Y < 0
        or position.X >= viewport.X or position.Y >= viewport.Y then
        return false
    end

    if inside(panel, position) or inside(restore, position) then
        setStatus("Panel zasłania cel. Przesuń go lub użyj F6.")
        return false
    end

    local released, err = release()
    if not released then error(tostring(err), 0) end

    VI:SendMouseButton(
        position, Enum.UserInputType.MouseButton1, true, 0
    )

    S.held = position
    task.wait(0.02)

    local releasedNow, releaseError = release()
    if not releasedNow then error(tostring(releaseError), 0) end

    return true
end

local function normalized(text)
    return string.lower(text):gsub("[%s_%-!]", "")
end

local function framesContainer()
    local ui = PG:FindFirstChild("UI")
    local base = ui and ui:FindFirstChild("Base")
    return base and base:FindFirstChild("Frames")
end

local function giftWindow()
    local frames = framesContainer()
    if not frames then return nil end

    for _, window in ipairs(frames:GetChildren()) do
        if visible(window) then
            local name = normalized(window.Name)

            if string.find(name, "playtime", 1, true)
                or name == "gifts"
                or name == "freegifts" then
                return window
            end

            for _, object in ipairs(window:GetDescendants()) do
                if object:IsA("TextLabel")
                    and normalized(object.Text) == "playtimerewards" then
                    return window
                end
            end
        end
    end
end

local function readyButton(window)
    for _, object in ipairs(window:GetDescendants()) do
        if (object:IsA("TextLabel") or object:IsA("TextButton"))
            and visible(object)
            and normalized(object.Text) == "ready" then

            local current = object

            while current and current ~= window do
                if current:IsA("GuiButton") and visible(current) then
                    return current
                end
                current = current.Parent
            end

            local parent = object.Parent

            if parent and parent:IsA("GuiObject")
                and parent.AbsoluteSize.X <= 300
                and parent.AbsoluteSize.Y <= 300 then

                local candidate
                local count = 0

                for _, child in ipairs(parent:GetDescendants()) do
                    if child:IsA("GuiButton") and visible(child) then
                        candidate = child
                        count = count + 1
                    end
                end

                if count == 1 then return candidate end
            end
        end
    end
end

local function giftOpener()
    local frames = framesContainer()
    local candidates = {}

    local function hasBadge(object)
        for _, child in ipairs(object:GetDescendants()) do
            if (child:IsA("TextLabel") or child:IsA("TextButton"))
                and visible(child)
                and child.Text:gsub("%s+", "") == "!" then
                return true
            end
        end
        return false
    end

    for _, object in ipairs(PG:GetDescendants()) do
        if object:IsA("GuiButton")
            and visible(object)
            and not (frames and object:IsDescendantOf(frames)) then

            local name = normalized(object:GetFullName())

            if (string.find(name, "gift", 1, true)
                or string.find(name, "playtime", 1, true))
                and hasBadge(object) then

                local size = object.AbsoluteSize

                if size.X > 0 and size.Y > 0
                    and size.X <= 180 and size.Y <= 180 then
                    table.insert(candidates, object)
                end
            end
        end
    end

    -- Nie klika innych ikon z wykrzyknikiem.
    if #candidates == 1 then return candidates[1] end
end

local function closeGift(window)
    for _, name in ipairs({"Close", "CloseButton", "Exit", "ExitButton"}) do
        local object = window:FindFirstChild(name, true)

        if object and object:IsA("GuiButton") and visible(object) then
            return click(object)
        end
    end

    return false
end

local cachedWindow
local nextWindowScan = 0
local lastWarning = -math.huge

-- Jedna pętla obsługuje wszystkie kliknięcia.
while S.alive do
    local delay = 0.1

    if (S.fish or S.gift)
        and not dragging
        and not UIS:GetFocusedTextBox() then

        local success, err = pcall(function()
            local released, releaseError = release()
            if not released then error(tostring(releaseError), 0) end

            local now = os.clock()

            if now >= nextWindowScan then
                nextWindowScan = now + 0.5
                cachedWindow = giftWindow()
            end

            local window = cachedWindow
            if window and not visible(window) then
                cachedWindow = nil
                window = nil
            end

            if window then
                if S.gift and now >= nextGiftCheck then
                    nextGiftCheck = now + 0.5
                    local target = readyButton(window)

                    if target then
                        if click(target) then
                            setStatus("Kliknięto gotowy prezent.")
                        end
                    elseif S.openedGift then
                        if closeGift(window) then
                            S.openedGift = false
                            cachedWindow = nil
                            nextGiftOpen = now + 5
                            setStatus("Prezenty sprawdzone. Okno zamknięte.")
                        else
                            setStatus("Nie znaleziono zamknięcia okna prezentów.")
                        end
                    else
                        setStatus("Brak wykrytych Ready! w tej zakładce.")
                    end
                elseif not S.gift then
                    setStatus("Zamknij prezenty, aby wznowić AutoFish.")
                end

                return
            end

            S.openedGift = false

            if S.gift and now >= nextGiftOpen then
                nextGiftOpen = now + 2
                local opener = giftOpener()

                if opener then
                    if click(opener) then
                        S.openedGift = true
                        nextGiftCheck = now + 0.5
                        nextWindowScan = 0
                        setStatus("Wykryto „!” — otwieram prezenty.")
                        task.wait(0.3)
                        return
                    end
                elseif not S.fish then
                    setStatus("Nie wykryto ikony. Możesz otworzyć prezenty ręcznie.")
                end
            end

            if S.fish then
                delay = 0.03

                local fishingGui = PG:FindFirstChild("FishingGui")
                local fishing = fishingGui
                    and fishingGui:FindFirstChild("Fishing")
                local target = fishing
                    and fishing:FindFirstChild("ClickSpeedUpActive", true)

                if visible(target) then
                    if click(target) then
                        setStatus("AutoFish działa.")
                    end
                else
                    setStatus("Czekam na cel łowienia...")
                end
            end
        end)

        if not success and S.alive then
            release()
            setStatus("Błąd kliknięcia. Zamknij F9/menu; szczegóły w konsoli.")
            delay = 0.2

            if os.clock() - lastWarning >= 10 then
                lastWarning = os.clock()
                warn("[BECZKA HUB]", err)
            end
        end
    end

    task.wait(delay)
end

release()

if env.__AutoFishPanel == S then
    env.__AutoFishPanel = nil
end
