local function toggleWindow()
    if not S.alive then return end
    panel.Visible = not panel.Visible
    restore.Visible = not panel.Visible
end

local function paint(object, enabled, name)
    object.Text = name .. (enabled and ": ON" or ": OFF")
    object.BackgroundColor3 = enabled and C.white or C.field
    object.TextColor3 = enabled and C.bg or C.white
end

