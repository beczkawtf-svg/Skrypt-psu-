local backendOK, VI = pcall(function()
    return UIS:CreateVirtualInput()
end)

if not backendOK then
    VI = nil
end

local function release()
    if not S.held then return true end

    local success, err = pcall(function()
        VI:SendMouseButton(
            S.held,
            Enum.UserInputType.MouseButton1,
            false,
            0
        )
    end)

    if success or string.find(
        tostring(err), "duplicate button state", 1, true
    ) then
        S.held = nil
        return true
    end

    return false, err
end

local function allowed()
    if not S.unlocked then
